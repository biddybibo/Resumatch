{
  "cleanUrls": true,
  "functions": {
    "api/tailor.js": {
      "maxDuration": 300
    },
    "api/coverletter.js": {
      "maxDuration": 300
    },
    "api/parse-pdf.js": {
      "maxDuration": 30
    },
    "api/parse-doc.js": {
      "maxDuration": 30
    },
    "api/stripe-checkout.js": {
      "maxDuration": 15
    },
    "api/stripe-webhook.js": {
      "maxDuration": 15
    },
    "api/assist.js": {
      "maxDuration": 300
    },
    "api/fetch-job.js": {
      "maxDuration": 20
    },
    "api/outcomes.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
